{
  "name": "yizhaklub-games",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": "^20.19.0 || >=22.12.0" },
  "workspaces": ["hub", "01_hedge_wars/client", "01_hedge_wars/server", "01_hedge_wars/packages/*"],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "typecheck": "tsc --noEmit",
    "build": "npm run build --workspace @yizhaklub/hub && npm run build --workspace @yizhaklub/hedge-client && npm run build --workspace @yizhaklub/hedge-server",
    "start": "node 01_hedge_wars/server/dist/index.js",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "test:dev": "E2E_MODE=development playwright test",
    "check:docs": "node scripts/check-docs.mjs",
    "check": "npm run typecheck && npm test && npm run check:docs && npm run build"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/node": "22.20.5",
    "@types/ws": "8.18.2",
    "esbuild": "0.27.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.8"
  }
}
